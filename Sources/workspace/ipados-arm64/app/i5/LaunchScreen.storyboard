                                    <constraint firstItem="launch-avatar" firstAttribute="centerX" secondItem="launch-brand" secondAttribute="centerX" id="avatar-center"/>
                                    <constraint firstItem="launch-signature" firstAttribute="top" secondItem="launch-avatar" secondAttribute="bottom" constant="24" id="signature-top"/>
                                    <constraint firstItem="launch-signature" firstAttribute="leading" secondItem="launch-brand" secondAttribute="leading" id="signature-leading"/>
                                    <constraint firstItem="launch-signature" firstAttribute="trailing" secondItem="launch-brand" secondAttribute="trailing" id="signature-trailing"/>
                                    <constraint firstItem="launch-signature" firstAttribute="bottom" secondItem="launch-brand" secondAttribute="bottom" id="signature-bottom"/>

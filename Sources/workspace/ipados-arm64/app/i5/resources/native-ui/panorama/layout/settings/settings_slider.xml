<root>
    <styles>
        <include src="file://{resources}/styles/csgostyles.css" />
        <include src="file://{resources}/styles/settings/settings_slider.css" />
        <include src="file://{resources}/styles/settings/settings_slider_mobile.css" />
    </styles>
    <CSGOSettingsSlider>
        <Panel id="ICSMSettingsSliderRow" class="left-right-flow vertical-center full-width">
            <Label id="Title" style="width: 60%; font-size: 22px; color: white; vertical-align: center;" />
            <Slider class="HorizontalSlider" direction="horizontal" id="Slider" />
            <TextEntry maxchars="4" textmode="numeric" id="Value" />
        </Panel>
    </CSGOSettingsSlider>
</root>

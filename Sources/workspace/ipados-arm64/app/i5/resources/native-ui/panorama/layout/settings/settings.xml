<root>
    <styles>
        <include src="file://{resources}/styles/csgostyles.css" />
        <include src="file://{resources}/styles/settings/settings.css" />
        <include src="file://{resources}/styles/mainmenu.css" />
        <include src="file://{resources}/styles/settings/settings_mobile.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/settingsmenu_shared.js" />
        <include src="file://{resources}/scripts/settingsmenu.js" />
    </scripts>
    <Panel class="mainmenu-content__container ICSMMobileSettings" useglobalcontext="true">
        <Panel class="content-navbar">
            <Label id="" class="content-navbar__title" text="#SFUI_HelpMenu_SettingsButton" />
        </Panel>
        <Panel class="content-navbar content-navbar--short">
            <Panel id="GameModeSelectionRadios" class="content-navbar__tabs">
                <RadioButton id="VideoRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab(&quot;VideoSettings&quot;)">
                    <Label class="" text="#settings_video" />
                </RadioButton>
                <RadioButton id="TouchRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab(&quot;TouchSettings&quot;);">
                    <Label text="触摸屏键位调整" />
                </RadioButton>
                <RadioButton id="GameRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab(&quot;GameSettings&quot;)">
                    <Label class="" text="#settings_game" />
                </RadioButton>
                <RadioButton id="AudioRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab(&quot;AudioSettings&quot;)">
                    <Label class="" text="#settings_audio" />
                </RadioButton>
                <RadioButton id="KBMouseRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab( &quot;KeybdMouseSettings&quot; )">
                    <Label class="" text="外接键鼠" />
                </RadioButton>
                <RadioButton id="ControllerRadio" group="SettingsNavBar" onactivate="SettingsMenu.NavigateToTab(&quot;ControllerSettings&quot;)">
                    <Label class="" text="外接手柄" />
                </RadioButton>
            </Panel>
        </Panel>
        <Panel id="SettingsMenuContent" class="full-width">

		</Panel>
    </Panel>
</root>
